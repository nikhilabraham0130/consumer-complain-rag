# -----------------------------------------------------------------------------
# Consumer Complaint Intelligence RAG - Environment Configuration Template
# Copy this file to '.env' and fill in your actual API keys.
# DO NOT commit your '.env' file to Git!
# -----------------------------------------------------------------------------

# LLM API Keys (Choose your preferred provider)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Embedding & Reranking Settings
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
CHROMA_PERSIST_DIR=./chroma_db

# CFPB Data Pipeline Settings
CFPB_DATA_DIR=./data
MAX_COMPLAINTS_TO_INGEST=10000

# FastAPI Backend Settings
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

